# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobflow"

# Authentication
AUTH_SECRET="replace-with-a-long-random-secret"

# Application
NEXT_PUBLIC_APP_NAME="JobFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Google Maps (optional; enables the interactive customer onboarding map picker)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
